#!/usr/bin/env bash
# Toggle the ASUS Zenbook Duo bottom OLED (eDP-2) for Omarchy/Hyprland.
#
# Default: OFF. Turn it on with the bar button or CLI.
# Folio/keyboard attach is NOT a hide path (stock Omarchy does not hide eDP-2).
#
# Live off/on: per-output DPMS (hl.dsp.dpms) + pin misc dpms-wake false so
# typing does not relight eDP-2. Also disable the bottom ELAN touch/stylus.
# Do NOT hyprctl reload. Do NOT
# disabled=true live — that fires monitorremoved and Omarchy closes
# omarchy-bar / omarchy-background (top bar flash).
# First ON after login (stub left the panel disabled) still enables once.
#
# Reboot persist: static stub lua reads STATE_FILE; desired!=on => disabled=true
# (lag-correct, no extra composite). Never rewrite toggles/hypr on toggle.
#
# SKU labels: UX8406CA (Lunar Lake) vs UX8406MA vs generic.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
STATE_FILE="$STATE_DIR/zenbook-duo-bottom-oled"
TOGGLE_DIR="$STATE_DIR/toggles/hypr"
STUB_FILE="$TOGGLE_DIR/zenbook-duo-bottom-oled.lua"
LEGACY_DISABLE="$TOGGLE_DIR/zenbook-duo-bottom-oled-disable.lua"
LEGACY_ENABLE="$TOGGLE_DIR/zenbook-duo-bottom-oled-enable.lua"
CLAMSHELL_LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-monitor-clamshell.lock"
MODELESS_LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-monitor-modeless.lock"

usage() {
  cat <<'EOF'
Usage: zenbook-duo-bottom-oled <off|on|toggle|status|apply>

  off      Blank bottom OLED (live: DPMS). Default. Login persist: disabled.
  on       Light bottom OLED below the top panel.
  toggle   Flip desired state.
  status   Print SKU, outputs, desired/live/dpms.
  apply    Re-apply desired state (missing state file => off).

EOF
}

sku_info() {
  local product="" board=""
  product=$(tr -d '\0' </sys/class/dmi/id/product_name 2>/dev/null || true)
  board=$(tr -d '\0' </sys/class/dmi/id/board_name 2>/dev/null || true)

  if [[ $product == *UX8406CA* || $board == *UX8406CA* ]]; then
    SKU="UX8406CA"
    SKU_CLASS="CA"
    SKU_NOTE="Lunar Lake, Arc 140V-class"
  elif [[ $product == *UX8406MA* || $board == *UX8406MA* ]]; then
    SKU="UX8406MA"
    SKU_CLASS="MA"
    SKU_NOTE="Meteor Lake — not the target SKU"
  else
    SKU="generic"
    SKU_CLASS="generic"
    SKU_NOTE="not UX8406CA / UX8406MA"
  fi

  DMI_PRODUCT="$product"
  DMI_BOARD="$board"
}

safe_connector() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

load_outputs() {
  local json
  json=$(hyprctl monitors all -j) || {
    echo "hyprctl monitors failed" >&2
    exit 1
  }

  mapfile -t EDPS < <(jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-")) | .name' <<<"$json" | sort)

  TOP="${EDPS[0]:-}"
  BOTTOM="${EDPS[1]:-}"

  if jq -e '.[] | select(.name == "eDP-2")' <<<"$json" >/dev/null; then
    BOTTOM="eDP-2"
  fi
  if jq -e '.[] | select(.name == "eDP-1")' <<<"$json" >/dev/null; then
    TOP="eDP-1"
  fi

  if [[ -z $BOTTOM || $BOTTOM == "$TOP" ]]; then
    echo "No bottom OLED found (need two internal panels). SKU=${SKU} (${SKU_CLASS})." >&2
    exit 1
  fi
  if ! safe_connector "$BOTTOM" || ! safe_connector "$TOP"; then
    echo "Refusing unsafe monitor name (top=$TOP bottom=$BOTTOM)" >&2
    exit 1
  fi

  BOTTOM_DISABLED=$(jq -r --arg n "$BOTTOM" '.[] | select(.name == $n) | .disabled' <<<"$json")
  BOTTOM_DPMS=$(jq -r --arg n "$BOTTOM" '.[] | select(.name == $n) | .dpmsStatus' <<<"$json")
  TOP_SCALE=$(jq -r --arg n "$TOP" '.[] | select(.name == $n) | .scale' <<<"$json")
}

desired_state() {
  if [[ -f $STATE_FILE ]]; then
    tr -d '[:space:]' <"$STATE_FILE"
  else
    echo off
  fi
}

write_state() {
  mkdir -p "$STATE_DIR"
  umask 022
  printf '%s\n' "$1" >"$STATE_FILE"
  chmod 644 "$STATE_FILE"
}

stub_lua() {
  cat <<EOF
-- squinto.zenbook-duo-bottom-oled — static stub, do not rewrite on toggle.
-- Login: desired!=on => disabled (lag-correct). Live toggle is DPMS, not this file.
local state_path = (os.getenv("XDG_STATE_HOME") or (os.getenv("HOME") .. "/.local/state")) .. "/omarchy/zenbook-duo-bottom-oled"
local f = io.open(state_path, "r")
local desired = "off"
if f then
  desired = (f:read("*l") or "off"):gsub("%s+", "")
  f:close()
end
if desired ~= "on" then
  hl.monitor({ output = "$BOTTOM", disabled = true })
end
EOF
}

ensure_stub() {
  mkdir -p "$TOGGLE_DIR"
  umask 022
  rm -f "$LEGACY_DISABLE" "$LEGACY_ENABLE"
  if [[ -f $STUB_FILE ]]; then
    return 0
  fi
  local tmp
  tmp=$(mktemp "$TOGGLE_DIR/.zenbook-duo-bottom-oled.lua.XXXXXX")
  stub_lua >"$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$STUB_FILE"
}

scale_lua() {
  if [[ ${TOP_SCALE:-} =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    printf '%s' "$TOP_SCALE"
  else
    printf '"auto"'
  fi
}

with_monitor_locks() {
  mkdir -p "${XDG_RUNTIME_DIR:-/tmp}"
  flock "$CLAMSHELL_LOCK" flock "$MODELESS_LOCK" "$@"
}

apply_live_disabled() {
  local lua=$1
  local want=$2
  with_monitor_locks bash -c '
    set -euo pipefail
    lua=$1
    want=$2
    bottom=$3
    out=$(hyprctl eval "$lua")
    rc=$?
    if [[ $rc -ne 0 || $out != ok ]]; then
      echo "hyprctl eval failed (exit $rc)" >&2
      echo "lua: $lua" >&2
      printf "%s\n" "$out" >&2
      exit 1
    fi
    for i in $(seq 1 20); do
      json=$(hyprctl monitors all -j) || exit 1
      got=$(jq -r --arg n "$bottom" ".[] | select(.name == \$n) | .disabled" <<<"$json")
      if [[ $got == "$want" ]]; then
        sleep 0.4
        exit 0
      fi
      sleep 0.1
    done
    echo "hyprctl eval did not set $bottom disabled=$want (live=$got). No reload fallback." >&2
    exit 1
  ' _ "$lua" "$want" "$BOTTOM"
}

# Per-output DPMS. Never omit monitor (global off blanks eDP-1).
live_dpms() {
  local action=$1
  local want=$2
  local lua out rc i json got
  lua="hl.dispatch(hl.dsp.dpms({ action = \"${action}\", monitor = \"${BOTTOM}\" }))"
  out=$(hyprctl eval "$lua")
  rc=$?
  if [[ $rc -ne 0 || $out != ok ]]; then
    echo "hyprctl dpms ${action} ${BOTTOM} failed (exit $rc)" >&2
    echo "lua: $lua" >&2
    printf '%s\n' "$out" >&2
    exit 1
  fi
  for i in $(seq 1 20); do
    json=$(hyprctl monitors all -j) || {
      echo "hyprctl monitors failed while waiting for dpms=$want" >&2
      exit 1
    }
    got=$(jq -r --arg n "$BOTTOM" '.[] | select(.name == $n) | .dpmsStatus' <<<"$json")
    if [[ $got == "$want" ]]; then
      return 0
    fi
    sleep 0.1
  done
  echo "dpms ${action} did not set $BOTTOM dpmsStatus=$want (live=$got)." >&2
  exit 1
}

set_dpms_wake() {
  local enabled=$1
  local lua out rc
  lua="hl.config({ misc = { key_press_enables_dpms = ${enabled}, mouse_move_enables_dpms = ${enabled} } })"
  out=$(hyprctl eval "$lua")
  rc=$?
  if [[ $rc -ne 0 || $out != ok ]]; then
    echo "hyprctl eval failed setting dpms-wake=${enabled} (exit $rc)" >&2
    printf '%s\n' "$out" >&2
    exit 1
  fi
}

set_bottom_digitizer() {
  local enabled=$1
  local name lua out
  for name in "elan9009:00-04f3:4448" "elan9009:00-04f3:4448-stylus"; do
    lua="hl.device({ name = \"${name}\", enabled = ${enabled} })"
    out=$(hyprctl eval "$lua")
    if [[ $out != ok ]]; then
      echo "hyprctl eval failed digitizer ${name} enabled=${enabled}: $out" >&2
      exit 1
    fi
  done
}

disable_bottom() {
  load_outputs
  write_state off
  ensure_stub
  set_dpms_wake false
  set_bottom_digitizer false
  if [[ $BOTTOM_DISABLED == true ]]; then
    return 0
  fi
  live_dpms off false
}

enable_bottom() {
  load_outputs
  write_state on
  ensure_stub
  set_dpms_wake true
  if [[ $BOTTOM_DISABLED == true ]]; then
    apply_live_disabled "hl.monitor({ output = \"$BOTTOM\", disabled = false, mode = \"preferred\", position = \"auto-down\", scale = $(scale_lua) })" false
    load_outputs
  fi
  if [[ $BOTTOM_DPMS != true ]]; then
    live_dpms on true
  fi
  set_bottom_digitizer true
}

print_status() {
  load_outputs
  local desired json_mode=0
  desired=$(desired_state)
  [[ ${1:-} == --json ]] && json_mode=1

  if (( json_mode )); then
    jq -n \
      --arg sku "$SKU" \
      --arg skuClass "$SKU_CLASS" \
      --arg skuNote "$SKU_NOTE" \
      --arg dmiProduct "$DMI_PRODUCT" \
      --arg dmiBoard "$DMI_BOARD" \
      --arg top "$TOP" \
      --arg bottom "$BOTTOM" \
      --arg desired "$desired" \
      --argjson bottomDisabled "$( [[ $BOTTOM_DISABLED == true ]] && echo true || echo false )" \
      --argjson bottomDpms "$( [[ $BOTTOM_DPMS == true ]] && echo true || echo false )" \
      '{
        sku: $sku,
        skuClass: $skuClass,
        skuNote: $skuNote,
        dmiProduct: $dmiProduct,
        dmiBoard: $dmiBoard,
        top: $top,
        bottom: $bottom,
        desired: $desired,
        bottomDisabled: $bottomDisabled,
        bottomDpms: $bottomDpms
      }'
    return
  fi

  cat <<EOF
sku:              $SKU ($SKU_CLASS) — $SKU_NOTE
dmi.product_name: $DMI_PRODUCT
dmi.board_name:   $DMI_BOARD
top:              $TOP
bottom:           $BOTTOM
desired:          $desired
live.disabled:    $BOTTOM_DISABLED
live.dpms:        $BOTTOM_DPMS
hide path:        live DPMS; login stub disables; no lua rewrite
EOF
}

apply_desired() {
  case "$(desired_state)" in
    on) enable_bottom ;;
    *) disable_bottom ;;
  esac
}

sku_info

cmd=${1:-}
case "$cmd" in
  off) disable_bottom ;;
  on) enable_bottom ;;
  toggle)
    if [[ $(desired_state) == on ]]; then
      disable_bottom
    else
      enable_bottom
    fi
    ;;
  status) print_status "${2:-}" ;;
  apply) apply_desired ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
